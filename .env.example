# Copier ce fichier en .env et adapter les valeurs pour la production.
# Ne JAMAIS committer un .env reel dans le depot Git.
# Noms de variables conformes au Volume 7 (Guide d'installation), Partie III.1.

DATABASE_URL=jdbc:postgresql://localhost:5432/educore
DATABASE_USER=educore
DATABASE_PASSWORD=changez-moi

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=changez-moi
S3_SECRET_KEY=changez-moi
S3_BUCKET=educore-documents

JWT_SECRET=generez-un-secret-aleatoire-256-bits-minimum-en-production
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
PASSWORD_EXPIRATION_DAYS=90

LOG_LEVEL=DEBUG

# Service independant Chat + Notifications (Phase 7)
NOTIFICATIONS_SERVICE_URL=http://localhost:8081
NOTIFICATIONS_SERVICE_KEY=generez-une-cle-aleatoire-en-production

# Reserves pour les phases ulterieures (Volume 7 III.1) - laisser vide pour l'instant
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
SMS_PROVIDER_API_KEY=
